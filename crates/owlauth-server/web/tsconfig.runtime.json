{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./node_modules/.cache/types/runtime",
    "tsBuildInfoFile": "./node_modules/.cache/runtime.tsbuildinfo"
  },
  "include": ["src/runtime/**/*.ts", "src/runtime/**/*.tsx", "src/vite-env.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "./tsconfig.shared.json" },
    { "path": "./tsconfig.generated-runtime.json" }
  ]
}
