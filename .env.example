# OwlAuth local application environment used by `make dev`.
# Copy this file to `.env`. Every credential below is public and disposable;
# generate independent random values before using OwlAuth outside local development.

OWLAUTH_MODE=all
OWLAUTH_INSTANCE_ID=local-development
OWLAUTH_RUNTIME_ADDR=127.0.0.1:8080
OWLAUTH_RUNTIME_BASE_URL=http://127.0.0.1:8080/
OWLAUTH_CLIENT_ADDR=127.0.0.1:8082
OWLAUTH_CLIENT_BASE_URL=http://127.0.0.1:8082/
OWLAUTH_CONTROL_ADDR=127.0.0.1:8081
OWLAUTH_CONTROL_BASE_URL=http://127.0.0.1:8081/
OWLAUTH_CONTROL_API_KEY=owl_ctrl_v1_CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk

OWLAUTH_CLIENT_KEY_DIGEST_KEY_VERSION=1
OWLAUTH_CLIENT_KEY_DIGEST_KEY=WlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlo
OWLAUTH_CLIENT_PROCESS_ID=local-client
OWLAUTH_REQUIRED_CLIENT_PROCESS_IDS=local-client
OWLAUTH_CLIENT_MAX_PROCESSES=1

OWLAUTH_POSTGRES_URL=postgresql://owlauth:owlauth_dev@127.0.0.1:5432/owlauth
OWLAUTH_MIGRATION_MODE=auto
OWLAUTH_ADMISSION_REDIS_URL=redis://127.0.0.1:6379/
