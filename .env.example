# OwlAuth local application environment used by `make dev`.
# Copy this file to `.env`. Every credential below is public and disposable;
# generate independent random values before using OwlAuth outside local development.

OWLAUTH_MODE=all
OWLAUTH_INSTANCE_ID=local-development

# Auth serves both the browser-facing Runtime surface and the backend-only Server API.
# Control remains an independently bound operator surface.
OWLAUTH_AUTH_ADDR=127.0.0.1:8080
OWLAUTH_AUTH_BASE_URL=http://127.0.0.1:8080/
OWLAUTH_CONTROL_ADDR=127.0.0.1:8081
OWLAUTH_CONTROL_BASE_URL=http://127.0.0.1:8081/

# Listener-level HTTP budgets. Runtime and Server API retain separate internal
# authorization and resource boundaries behind the shared Auth listener.
OWLAUTH_AUTH_REQUEST_TIMEOUT_MS=10000
OWLAUTH_AUTH_MAX_REQUEST_BYTES=1048576
OWLAUTH_AUTH_MAX_IN_FLIGHT_REQUESTS=256
OWLAUTH_AUTH_MAX_CONNECTIONS=512
OWLAUTH_AUTH_MAX_HEADER_COUNT=128
OWLAUTH_AUTH_MAX_HEADER_BYTES=65536
OWLAUTH_AUTH_MAX_URI_BYTES=8192
OWLAUTH_CONTROL_REQUEST_TIMEOUT_MS=10000
OWLAUTH_CONTROL_MAX_REQUEST_BYTES=1048576
OWLAUTH_CONTROL_MAX_IN_FLIGHT_REQUESTS=64
OWLAUTH_CONTROL_MAX_CONNECTIONS=128
OWLAUTH_CONTROL_MAX_HEADER_COUNT=128
OWLAUTH_CONTROL_MAX_HEADER_BYTES=65536
OWLAUTH_CONTROL_MAX_URI_BYTES=8192

OWLAUTH_CONTROL_API_KEY=owl_ctrl_v1_CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk

OWLAUTH_SERVER_KEY_DIGEST_KEY_VERSION=1
OWLAUTH_SERVER_KEY_DIGEST_KEY=WlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlpaWlo

# All pools must resolve to one PostgreSQL server and database authority. The
# generic URL supplies that authority locally; pool bounds remain surface-specific.
OWLAUTH_POSTGRES_URL=postgresql://owlauth:owlauth_dev@127.0.0.1:5432/owlauth
OWLAUTH_RUNTIME_DATABASE_MAX_CONNECTIONS=20
OWLAUTH_SERVER_DATABASE_MAX_CONNECTIONS=10
OWLAUTH_CONTROL_DATABASE_MAX_CONNECTIONS=5
OWLAUTH_MIGRATION_MODE=auto

OWLAUTH_SOFTWARE_CUSTODY_KEY=Hh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4

OWLAUTH_RUNTIME_KEY_VERSION=1
OWLAUTH_RUNTIME_DIGEST_KEY=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM
OWLAUTH_RUNTIME_PROTECTION_KEY=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ

OWLAUTH_EMAIL_IDENTITY_KEY_VERSION=1
OWLAUTH_EMAIL_IDENTITY_DIGEST_KEY=PT09PT09PT09PT09PT09PT09PT09PT09PT09PT09PT0
OWLAUTH_EMAIL_IDENTITY_PROTECTION_KEY=Pj4-Pj4-Pj4-Pj4-Pj4-Pj4-Pj4-Pj4-Pj4-Pj4-Pj4

OWLAUTH_PROJECTION_EMAIL_KEY_VERSION=1
OWLAUTH_PROJECTION_EMAIL_PROTECTION_KEY=R0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0c

OWLAUTH_MANAGED_REAUTHORIZATION_KEY_VERSION=1
OWLAUTH_MANAGED_REAUTHORIZATION_DIGEST_KEY=CgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgoKCgo
OWLAUTH_MANAGED_REAUTHORIZATION_PROTECTION_KEY=CwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCwsLCws

OWLAUTH_IDENTITY_MUTATION_EVIDENCE_KEY_VERSION=1
OWLAUTH_IDENTITY_MUTATION_EVIDENCE_DIGEST_KEY=EBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBA
